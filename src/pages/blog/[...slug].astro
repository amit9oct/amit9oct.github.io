---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, readingTime, tagSlug } from '../../lib/utils';
import { site } from '../../data/site';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, subtitle, date, updated, tags, thumbnail, paper, code, comments } = post.data;
const shareUrl = `https://x.com/intent/tweet?${new URLSearchParams({
  text: title,
  url: new URL(`/blog/${post.id}`, Astro.site).toString(),
  via: site.x,
})}`;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base title={title} description={subtitle ?? title} image={thumbnail} type="article">
  <article class="container">
    <header class="post-header">
      <a class="label" href="/blog" style="text-decoration:none">← Blog</a>
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      <div class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span>updated {formatDate(updated)}</span>}
        <span>{readingTime(post.body)} min read</span>
      </div>
      {
        (paper || code || comments) && (
          <div class="post-links">
            {paper && <a class="btn" href={paper}>Paper ↗</a>}
            {code && <a class="btn" href={code}>Code ↗</a>}
            {comments && (
              <a class="btn" href="#discussion" data-comment-count>
                Comments ↓
              </a>
            )}
          </div>
        )
      }
    </header>

    <div class="post-layout">
      <div class="prose">
        <Content />
      </div>
      {
        toc.length > 2 && (
          <nav class="toc" aria-label="Table of contents">
            <span class="label">Contents</span>
            <ol>
              {toc.map((h) => (
                <li class={`d${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </div>

    <div class="post-end qed" aria-hidden="true">∎</div>

    <footer class="post-footer">
      {
        tags.length > 0 && (
          <div class="tags" style="margin-bottom:1rem">
            {tags.map((t) => (
              <a href={`/blog/tags/${tagSlug(t)}`}>#{t}</a>
            ))}
          </div>
        )
      }
      Thoughts or questions? I'd love to hear from you. <a href={`mailto:${site.email}`}>Email me</a>,{' '}
      <a href={`https://x.com/${site.x}`}>find me on X</a>, or <a href={site.calendly}>book a chat</a>.
      <div class="post-links">
        <a class="btn" href={shareUrl}>Share on X ↗</a>
      </div>
    </footer>

    {comments && <Comments term={`blog/${post.id}`} />}
  </article>
</Base>
